    {
      "path": "support.upload-url",
      "type": "url",
      "encoding": "url",
      "limit": 1024,
      "https": true,
      "trust": "consent",
      "introduced": 1,
      "absence": "withdraw",
      "consumer": "support",
      "available": true
    }
