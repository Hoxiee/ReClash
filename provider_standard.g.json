      "path": "provider.name",
      "type": "text",
      "encoding": "string-or-locale-map",
      "limit": 160,
      "trust": "display",
      "introduced": 1,
      "absence": "withdraw",
      "consumer": "panel",
      "available": true
    },
    {
      "path": "provider.logo",
      "type": "url",
      "encoding": "url",
      "limit": 1024,
      "trust": "display",
      "introduced": 1,
      "absence": "withdraw",
      "consumer": "panel",
      "available": true
    },
    {
      "path": "provider.logo-dark",
      "type": "url",
      "encoding": "url",
      "limit": 1024,
      "trust": "display",
      "introduced": 1,
      "absence": "withdraw",
      "consumer": "panel",
      "available": true
    },
    {
      "path": "provider.support-url",
      "type": "url",
      "encoding": "url",
      "limit": 1024,
