<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_row_background"
    android:gravity="center_vertical"
    android:minHeight="34dp"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <ImageView
        android:id="@+id/widget_item_mark"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_widget_selected" />

    <TextView
        android:id="@+id/widget_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_item_delay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
